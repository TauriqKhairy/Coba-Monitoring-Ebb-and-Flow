# Konfigurasi Firebase Web SDK (Modular v9+)
# Dapatkan nilai ini dari Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForMockOrTesting123456
VITE_FIREBASE_AUTH_DOMAIN=hidroponik-ebbflow.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://hidroponik-ebbflow-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=hidroponik-ebbflow
VITE_FIREBASE_STORAGE_BUCKET=hidroponik-ebbflow.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ID Perangkat ESP32 aktif default
VITE_DEFAULT_DEVICE_ID=esp32_hidroponik_01
